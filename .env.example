# Copy this file to ".env" and put your real key there.
# .env is listed in .gitignore, so it will not be pushed to GitHub.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: a second model to try if the main one stays overloaded (503) after retries.
# GEMINI_FALLBACK_MODEL=
